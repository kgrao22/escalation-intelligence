# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real tokens.

# Slack bot token for a Slack app installed in the workspace.
# Read scopes:  channels:read, channels:history
#               (use groups:read / groups:history if the channels are private)
# Write scope:  chat:write — required ONLY by `intelligence:slack-publish`.
#               Application guards restrict every write to C0DEST00000; the
#               source channel C0SOURCE0000 can never receive a post.
# Do NOT grant chat:write.public, files:write, reactions:write, users:write,
# or any admin scope — none are used.
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# The channel Escalation Intelligence reads from. Treated as READ ONLY —
# the application will never post, edit, or react in this channel.
SLACK_SOURCE_CHANNEL_ID=C0SOURCE0000

# The channel Escalation Intelligence publishes generated reports to.
# Must be different from SLACK_SOURCE_CHANNEL_ID — the app refuses to
# start (and later, refuses to post) if these two values match.
SLACK_DEST_CHANNEL_ID=C0DEST00000

# How many days back to analyse. Defaults to 30 if unset.
SLACK_DAYS_BACK=30

# Anthropic API key, required only by `npm run intelligence:extract`
# (not needed for slack:probe or slack:fetch). Never logged or printed.
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Claude model used for LLM extraction. Defaults to claude-haiku-4-5 if unset
# — chosen for low-cost structured classification/extraction over many
# threads; override with a Sonnet/Opus model if extraction quality warrants
# the extra cost. See README.md for the full rationale.
ANTHROPIC_MODEL=claude-haiku-4-5

# Voyage AI API key, required only by `npm run intelligence:embed`
# (not needed for any other command). Never logged or printed.
VOYAGE_API_KEY=pa-your-voyage-api-key-here

# Voyage embedding model. Defaults to voyage-4-large if unset, producing
# 1024-dimensional float vectors. `output_dimension` is never sent, so the
# model's default dimension applies and is recorded in the output metadata.
# Changing this invalidates embedding reuse — vectors from different models
# are not comparable.
VOYAGE_EMBEDDING_MODEL=voyage-4-large

# Cosine-similarity floor for recurrence CANDIDATE GENERATION only.
# This is NOT a "same issue" threshold — it decides which pairs are worth
# asking Claude to inspect. The recurrence decision is made by the LLM
# adjudicator. Lower it to widen the search (and increase cost).
RECURRENCE_CANDIDATE_SIMILARITY=0.60
